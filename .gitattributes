* text=auto
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf

# >>> continuum >>>
# Continuum — the development package is judged by its bytes; keep them LF everywhere.
continuum/** text=auto eol=lf
continuum/**/*.jsonl text eol=lf
continuum/**/*.json text eol=lf
continuum/**/*.adl text eol=lf
continuum/**/*.md text eol=lf
continuum/**/*.txt text eol=lf
