{
  "acceptance-scenario": "1",
  "name": "b09-secret-redaction",
  "purpose": "Credentials never appear in metadata, logs, exceptions or MCP output",
  "verifies": [
    "::SQLInvestigator.Investigation.InvestigateData.NoSecretDisclosure",
    "::SQLInvestigator.Investigation.QueryExecution.SecretRedaction",
    "::SQLInvestigator.Investigation.QueryExecution.CredentialVault"
  ],
  "test": "::SQLInvestigator.SecretRedactionSuite",
  "environment": "LocalDevelopment",
  "given": [
    {
      "step": "connection.provision",
      "args": {
        "alias": "alpha",
        "credential": "fixture-secret"
      },
      "text": "the developer provisions alias \"alpha\" at the local console, typing the secret there"
    }
  ],
  "when": [
    {
      "step": "connection.exercise-error-paths",
      "args": {},
      "text": "connection errors are provoked (wrong password, unreachable server)"
    }
  ],
  "then": [
    {
      "step": "output.excludes-secret",
      "args": {
        "value": "fixture-secret"
      },
      "text": "no MCP output contains the secret \"fixture-secret\""
    },
    {
      "step": "logs.exclude-secret",
      "args": {
        "value": "fixture-secret"
      },
      "text": "no stderr diagnostic contains \"fixture-secret\""
    },
    {
      "step": "storage.excludes-plaintext-secret",
      "args": {
        "value": "fixture-secret"
      },
      "text": "no file on disk contains \"fixture-secret\" in plaintext"
    }
  ]
}
