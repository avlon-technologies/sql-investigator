model {
  bdl         1.0
  types       adl-type/1.0
  expressions adl-expr/1.0
  definition  "2026-11-05.1"
}
business SQLInvestigation #b-1001 {
  description "Authorized developer investigations with evidence and confidentiality."
  purpose {
    "answer investigation questions with reproducible evidence"
    "protect credentials and confidential data during investigations"
  }
  modality { epistemic stated }
  provenance { source domain-expert, assertedBy "Product owner", assertedOn 2026-11-05 }
  domain Investigation #d-1001 {
    purpose { "Establish evidence-backed findings from authorized read-only observations" }
    capability ExploreAuthorizedData #c-1001 { purpose { "Inspect approved data without changing it" } }
    capability CorrelateEvidence #c-1002 { purpose { "Compare observations across independent systems" } }
    capability PreserveProvenance #c-1003 { purpose { "Retain evidence and uncertainty for later review" } }
    action InspectSchema [permitted] #ac-1001 { mayPerform Investigator exercises ExploreAuthorizedData }
    action ExecuteReadQuery [permitted] #ac-1002 { mayPerform Investigator exercises ExploreAuthorizedData }
    action RecordFinding [permitted] #ac-1003 { mayPerform Investigator exercises PreserveProvenance }
    action ProposeRelationship [permitted] #ac-1004 { mayPerform Investigator exercises CorrelateEvidence }
    unspecified SensitiveDataPolicy #u-1001 {
      modality { epistemic underspecified }
      question "Which production data classifications may be returned to the cloud agent?"
      reason "Requires workplace approval for each environment."
      accountable "Data owner"
      alternatives
        "approved development data only"
        "approved production subsets after review"
    }
  }
  actor Investigator [person] #a-1001 { }
}