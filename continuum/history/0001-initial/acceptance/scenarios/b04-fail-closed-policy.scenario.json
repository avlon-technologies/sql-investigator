{
  "acceptance-scenario": "1",
  "name": "b04-fail-closed-policy",
  "purpose": "Ambiguous parsing and unauthorized objects or aliases fail closed",
  "verifies": [
    "::SQLInvestigator.Investigation.InvestigateData.ReadOnly",
    "::SQLInvestigator.Investigation.QueryExecution.SelectOnlyAllowlist",
    "::SQLInvestigator.Investigation.QueryExecution.ApprovedEnvironmentsOnly",
    "::SQLInvestigator.Investigation.QueryExecution.QueryGateway"
  ],
  "test": "::SQLInvestigator.ReadOnlyEnforcement",
  "environment": "LocalDevelopment",
  "given": [
    {
      "step": "connection.fixture",
      "args": {
        "alias": "alpha",
        "scope": "dbo.Orders"
      },
      "text": "alias \"alpha\" points at a disposable SQL Server fixture, scoped to dbo.Orders, through a read-only principal"
    }
  ],
  "when": [
    {
      "step": "sql.reject-policy-corpus",
      "args": {
        "cases": [
          "parser-ambiguity",
          "policy-unavailable",
          "forbidden-table",
          "forbidden-column",
          "unauthorized-alias",
          "openrowset",
          "cross-database-reference"
        ]
      },
      "text": "Claude Code submits each fail-closed policy case"
    }
  ],
  "then": [
    {
      "step": "sql.all-rejected-before-execution",
      "args": {},
      "text": "every statement is rejected before it reaches SQL Server, with an audited reason"
    }
  ]
}
