#!/bin/sh
# Continuum — installed by `continuum install`; do not edit.
# Put your own post-commit logic in .githooks/post-commit.local (it runs first).
d=$(dirname "$0")
if [ -f "$d/post-commit.local" ]; then sh "$d/post-commit.local" "$@" || exit $?; fi

# APPLICABILITY FIRST (DEVELOPMENT-LIFECYCLE 12.1.3) — the same decision `continuum install`, `doctor`
# and the Guard make, re-made here because a hook outlives the install that wrote it: where continuum/
# holds no package, no spec and no model, there is nothing to judge — NOT APPLICABLE, exit 0, and no
# Host is asked. A hook never makes a repository managed. (A ledger or workflow record alone is a
# BROKEN managed repository: that case goes to `continuum guard`, which says INDETERMINATE.)
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
if [ ! -f "$root/continuum/PACKAGE.json" ] && [ ! -f "$root/continuum/development-package.json" ] \
   && ! ls "$root/continuum/model/"*.adl-manifest.json >/dev/null 2>&1 \
   && [ ! -f "$root/continuum/ledger.json" ] && [ ! -f "$root/continuum/workflow.jsonl" ]; then
  exit 0
fi

if ! command -v continuum >/dev/null 2>&1; then
  echo "continuum: not on PATH — the architecture check did not run." >&2
  exit 0
fi

continuum guard post-commit "$@"
status=$?
# FOUR CODES, THREE OUTCOMES, AND A POLICY OVER THE THIRD:
#
#   0  PASS           a semantic positive judgment
#   1  FAIL           a semantic NEGATIVE judgment — obtained, and not a transport fault
#   2  INDETERMINATE  no judgment was obtained, and none was required here
#   3  INDETERMINATE  no judgment was obtained and one WAS required — so it blocks
#
# 2 and 3 are the same outcome under different policy. The repository decides which,
# in committed configuration (continuum/guard.json  requireJudgment), so opting in is
# done once for everyone rather than by each developer editing this file — which is
# why this hook reads a policy it does not itself define. 2 stays permissive on
# purpose: blocking a local commit because a credential expired is hostile, and
# continuum guard has already printed WHICH kind of non-judgment it was.
if [ $status -eq 1 ] || [ $status -eq 3 ]; then exit $status; fi
if [ $status -ne 0 ]; then
  echo "continuum: no authoritative architecture check ran (exit $status). post-commit allowed." >&2
  echo "continuum: this is not a pass — nothing was checked. To make it blocking here," >&2
  echo "continuum: set requireJudgment in continuum/guard.json." >&2
fi
exit 0
